{
  "name": "@zerohat/tidoc",
  "version": "0.1.6",
  "description": "CLI tool that scans .md files and serves them as a documentation website",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "documentation",
    "markdown",
    "docs",
    "cli",
    "static-site",
    "live-reload"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tung/tidoc"
  },
  "bin": {
